{
  "android": {
    "arm64": true,
    "immersive": true,
    "keepScreenOn": true,
    "minSdk": 26,
    "orientation": "sensorLandscape",
    "outputDir": "Build/Android",
    "packageName": "",
    "targetSdk": 0,
    "versionCode": 1,
    "x86_64": true
  },
  "build": {
    "cleanFirst": false,
    "development": false,
    "excludeExtensions": ".cpp .h .hpp .inl .fbx .glb .gltf .blend .psd .ini",
    "excludeFolders": [
      "Assets/Scripts"
    ],
    "openFolder": true,
    "outputDir": "Build/Windows",
    "stopOnProblems": false,
    "zip": false
  },
  "input": {
    "cursor": "visible"
  },
  "platform": "windows",
  "product": {
    "company": "",
    "copyright": "",
    "icon": "",
    "name": "Shipfulness",
    "version": "1.0.0"
  },
  "render": {
    "aa": "x4",
    "lighting": "soft",
    "shadowAA": "x4",
    "shadows": "high"
  },
  "scenes": [
    {
      "enabled": true,
      "name": "Main",
      "path": "Scenes/Main.strscene"
    }
  ],
  "web": {
    "embedHeight": 720,
    "embedWidth": 1280,
    "fullscreenButton": true,
    "language": "en",
    "outputDir": "Build/Web",
    "runInBackground": true,
    "startPrompt": "",
    "zip": true
  },
  "window": {
    "fullscreenToggle": true,
    "height": 1080,
    "mode": "windowed",
    "resizable": true,
    "runInBackground": true,
    "vsync": false,
    "width": 1920
  }
}